# ======================================
# App Environment
# ======================================
# development | staging | production
APP_ENV=development

# Public base URLs (set your real domain in production)
PUBLIC_WEB_BASE_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost/api

# Next.js public API base (usually keep /api behind nginx)
NEXT_PUBLIC_API_BASE=/api


# ======================================
# PostgreSQL
# ======================================
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/paidlink


# ======================================
# Redis
# ======================================
REDIS_URL=redis://redis:6379/0


# ======================================
# Security / Tokens
# ======================================
JWT_SECRET=change_me_super_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=30
REDIRECT_TOKEN_EXPIRE_MINUTES=10


# ======================================
# Flow / Anti-fraud
# ======================================
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
STEP_RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300


# ======================================
# Optional
# ======================================
# Override shared tiers file path (mainly for container mounts)
TIERS_FILE_PATH=/packages/shared/tiers.json
