APP_ENV=development

# Shared
PUBLIC_WEB_BASE_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost/api

# Database/Redis
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/paidlink
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=change_me_super_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=30
REDIRECT_TOKEN_EXPIRE_MINUTES=10

# Flow rules
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
STEP_RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300

# Web
NEXT_PUBLIC_API_BASE=/api
