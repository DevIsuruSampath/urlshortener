# ======================================
# App Environment
# ======================================
# development | staging | production
APP_ENV=development

# Public base URLs (set your real domain in production)
# Option A (single domain):
#   PUBLIC_WEB_BASE_URL=https://example.com
#   PUBLIC_API_BASE_URL=https://example.com/api
#   NEXT_PUBLIC_API_BASE=/api
# Option B (subdomain, no /api path):
#   PUBLIC_WEB_BASE_URL=https://example.com
#   PUBLIC_API_BASE_URL=https://api.example.com
#   NEXT_PUBLIC_API_BASE=https://api.example.com
PUBLIC_WEB_BASE_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_API_BASE=/api
# Optional: server-side web proxy target for short-code pass-through when web/api are split services
API_INTERNAL_BASE_URL=http://localhost:8000


# ======================================
# PostgreSQL
# ======================================
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/paidlink


# ======================================
# Redis
# ======================================
REDIS_URL=redis://redis:6379/0


# ======================================
# Security / Tokens
# ======================================
JWT_SECRET=change_me_super_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=30
REDIRECT_TOKEN_EXPIRE_MINUTES=10


# ======================================
# Flow / Anti-fraud
# ======================================
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
STEP_RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300


# ======================================
# Optional
# ======================================
# Override shared tiers file path (mainly for container mounts)
TIERS_FILE_PATH=/packages/shared/tiers.json
