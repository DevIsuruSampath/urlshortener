# ======================================
# API (FastAPI) — Backend
# Domains: api.example.com, exa.com
# ======================================

APP_ENV=production

# ── URLs & Domains ──
PUBLIC_WEB_BASE_URL=https://example.com
PUBLIC_API_BASE_URL=https://api.example.com
SHORT_LINK_DOMAIN=exa.com
INTERSTITIAL_DOMAIN=adsexample.com

# ── CORS (comma-separated) ──
CORS_ORIGINS=https://example.com,https://admin.example.com,https://adsexample.com,https://exa.com

# ── PostgreSQL ──
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_HOST=REPLACE_DB_HOST
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/paidlink

# ── Redis ──
REDIS_URL=redis://default:REPLACE_REDIS_PASSWORD@REPLACE_REDIS_HOST:6379/0

# ── Secrets ──
FLOW_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=15
REDIRECT_TOKEN_EXPIRE_MINUTES=10

# ── Flow / Anti-fraud ──
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
START_RATE_LIMIT_PER_MINUTE=120
STEP_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=20
DEV_API_RATE_LIMIT_PER_MINUTE=60
ADMIN_SETUP_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_LOCKOUT_THRESHOLD=10
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_PROGRESSIVE_DELAY_MAX_SECONDS=2
REQUIRE_HTTPS_FOR_ADMIN_SETUP=true
CACHE_TTL_SECONDS=300

# ── Admin Auth ──
ADMIN_SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_BOOTSTRAP_TOKEN
ADMIN_SESSION_COOKIE_NAME=paidlink_admin_session
ADMIN_API_TOKENS=REPLACE_TOKEN_1,REPLACE_TOKEN_2

# ── Cookie Security ──
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=.example.com

# ── Misc ──
RUN_MIGRATIONS=false
DATABASE_AUTO_CREATE=false
POSTGRES_ADMIN_DB=postgres
TIERS_FILE_PATH=/packages/shared/tiers.json
