# === App ===
APP_ENV=production

# === Domains (Mapped automatically) ===
# No protocols for these (except API_BASE/WEB_BASE if preferred, but config handles it)
APP_DOMAIN=example.com
ADS_DOMAIN=adsexample.com
SHORT_DOMAIN=exa.com

# === CORS (Full URLs) ===
CORS_ORIGINS=http://example.com,http://admin.example.com,http://adsexample.com,http://exa.com,http://auth.example.com

# === Database ===
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/paidlink
REDIS_URL=redis://redis:6379/0

# === Secrets ===
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Admin Auth ===
# Only needed for legacy token setup, log-based bootstrap handles the user creation
ADMIN_SESSION_COOKIE_NAME=paidlink_admin_session
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# === Optional Settings ===
# FIRST_STEP_MIN_SECONDS=8
# NEXT_STEP_MIN_SECONDS=3
