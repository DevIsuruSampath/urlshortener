# ============================================
# URL Shortener API - Environment Configuration
# ============================================

# === Application Environment ===
APP_ENV=production                    # development, staging, production

# === Database Configuration ===
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/paidlink
REDIS_URL=redis://redis:6379/0

# === Security & Secrets ===
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_OR_MORE_FOR_SECURITY
JWT_ALG=HS256                         # JWT algorithm (HS256, HS384, HS512)
ACCESS_TOKEN_EXPIRE_MINUTES=60        # Admin session token expiration

# === Rate Limiting Configuration ===
START_RATE_LIMIT_PER_MINUTE=120       # Rate limit for link start requests
STEP_RATE_LIMIT_PER_MINUTE=60         # Rate limit for step completion requests
AUTH_RATE_LIMIT_PER_MINUTE=20         # Rate limit for authentication endpoints
ADMIN_SETUP_RATE_LIMIT_PER_MINUTE=5   # Rate limit for admin setup endpoint
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10  # Rate limit for admin login
DEV_API_RATE_LIMIT_PER_MINUTE=60      # Rate limit for developer API endpoints

# === Admin Security ===
ADMIN_LOGIN_LOCKOUT_THRESHOLD=10      # Failed attempts before lockout
ADMIN_LOGIN_LOCKOUT_MINUTES=15        # Lockout duration in minutes
ADMIN_LOGIN_PROGRESSIVE_DELAY_MAX_SECONDS=2  # Progressive delay for failed logins
REQUIRE_HTTPS_FOR_ADMIN_SETUP=true    # Require HTTPS for admin setup (production only)

# === Admin Setup Token (One-time use) ===
# Generate with: openssl rand -hex 32
ADMIN_SETUP_TOKEN=CHANGE_ME_GENERATE_RANDOM_HEX_32

# === Admin API Tokens (Comma-separated) ===
# For programmatic access to admin endpoints
ADMIN_API_TOKENS=token1,token2,token3

# === Cookie Configuration ===
ADMIN_SESSION_COOKIE_NAME=paidlink_admin_session
COOKIE_DOMAIN=.example.com            # Cookie domain (.example.com for subdomains)
COOKIE_SECURE=true                    # Secure cookies (HTTPS only)
COOKIE_SAMESITE=lax                   # SameSite policy (lax, strict, none)
COOKIE_HTTPONLY=true                  # HTTP-only cookies

# === Domain Configuration ===
# Domain names without protocol (used for CORS and redirects)
APP_DOMAIN=example.com                # Main application domain
ADS_DOMAIN=adsexample.com             # Ad interstitial domain
SHORT_DOMAIN=exa.com                  # Short link domain

# === Public URLs (with protocol) ===
PUBLIC_WEB_BASE_URL=https://example.com
PUBLIC_API_BASE_URL=https://api.example.com

# === Ad Flow Timing ===
FIRST_STEP_MIN_SECONDS=8              # Minimum seconds for first ad step
NEXT_STEP_MIN_SECONDS=3               # Minimum seconds for subsequent steps

# === CORS Origins (Full URLs, comma-separated) ===
CORS_ORIGINS=https://example.com,https://admin.example.com,https://adsexample.com,https://exa.com,https://auth.example.com

# === Cache Configuration ===
CACHE_TTL_SECONDS=300                 # Redis cache TTL in seconds

# === Database Management ===
DATABASE_AUTO_CREATE=true             # Auto-create database if not exists
RUN_MIGRATIONS=true                   # Run database migrations on startup

# === Tiers Configuration ===
# Path to tiers.json file (optional, defaults to packages/shared/tiers.json)
# TIERS_FILE_PATH=/path/to/tiers.json
