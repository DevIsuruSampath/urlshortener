# ============================================
# URL Shortener Web - Environment Configuration
# ============================================

# === Branding ===
PROJECT_NAME="URL Shortener"

# === Domain Configuration (No Protocol) ===
# These domains are used by the middleware for routing
APP_DOMAIN=example.com                # Main application domain
ADMIN_DOMAIN=admin.example.com        # Admin dashboard domain (with /login)
ADS_DOMAIN=adsexample.com             # Ad interstitial domain
SHORT_DOMAIN=exa.com                  # Short link domain

# === API Configuration ===
# Public API URL (used by browser clients)
API_BASE=https://api.example.com

# Internal API URL (used for server-side rewrites)
# Use this when running in Docker/container environment
INTERNAL_API_HOST=http://api:8000

# === Next.js Configuration ===
# Uncomment for production deployment
# NEXT_PUBLIC_API_BASE=https://api.example.com
# NEXT_PUBLIC_ADMIN_DOMAIN=admin.example.com

# === Development Overrides ===
# Uncomment for local development
# APP_DOMAIN=localhost:3000
# ADMIN_DOMAIN=admin.localhost:3000
# AUTH_DOMAIN=auth.localhost:3000
# ADS_DOMAIN=ads.localhost:3000
# SHORT_DOMAIN=short.localhost:3000
# API_BASE=http://localhost:8000
# INTERNAL_API_HOST=http://localhost:8000
