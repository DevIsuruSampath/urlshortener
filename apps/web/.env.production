# ============================================
# URL Shortener Web - Production Configuration
# ============================================

# === Branding ===
PROJECT_NAME="URL Shortener"

# === Domain Configuration (No Protocol) ===
APP_DOMAIN=example.com                # Main application domain
ADMIN_DOMAIN=admin.example.com        # Admin dashboard domain
ADS_DOMAIN=ads.example.com            # Ad interstitial domain
SHORT_DOMAIN=short.example.com        # Short link domain

# === API Configuration ===
# Public API URL (used by browser clients)
API_BASE=/api

# Internal API URL (used for server-side rewrites)
# CHANGE THIS TO YOUR ACTUAL API SERVER URL!
INTERNAL_API_HOST=http://localhost:8000  # Change to your API server URL

# === Production Flags ===
NODE_ENV=production

# === Next.js Configuration ===
NEXT_PUBLIC_PROJECT_NAME="URL Shortener"