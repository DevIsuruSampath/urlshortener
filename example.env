# ======================================
# Full ENV for docker-compose / single deploy
# ======================================

APP_ENV=production

# ── Branding ──
NEXT_PUBLIC_PROJECT_NAME=PaidLink URL Shortener

# ── URLs & Domains ──
PUBLIC_WEB_BASE_URL=http://example.com
PUBLIC_API_BASE_URL=http://api.example.com
NEXT_PUBLIC_API_BASE=http://api.example.com
NEXT_PUBLIC_AUTH_DOMAIN=auth.example.com
SHORT_LINK_DOMAIN=exa.com
INTERSTITIAL_DOMAIN=adsexample.com

# ── CORS (frontend domains only) ──
CORS_ORIGINS=http://example.com,http://admin.example.com,http://adsexample.com,http://exa.com,http://auth.example.com

# ── PostgreSQL ──
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/paidlink

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Secrets ──
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Flow / Anti-fraud ──
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
START_RATE_LIMIT_PER_MINUTE=120
STEP_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=20
DEV_API_RATE_LIMIT_PER_MINUTE=60
ADMIN_SETUP_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_LOCKOUT_THRESHOLD=10
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_PROGRESSIVE_DELAY_MAX_SECONDS=2
REQUIRE_HTTPS_FOR_ADMIN_SETUP=false
CACHE_TTL_SECONDS=300

# ── Admin Auth ──
ADMIN_SETUP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN
ADMIN_SESSION_COOKIE_NAME=paidlink_admin_session
ADMIN_API_TOKENS=CHANGE_ME_API_TOKEN_1

# ── Cookie Security ──
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=.example.com

# ── Misc ──
RUN_MIGRATIONS=true
DATABASE_AUTO_CREATE=true
POSTGRES_ADMIN_DB=postgres
TIERS_FILE_PATH=/packages/shared/tiers.json
