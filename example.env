# ======================================
# Production ENV (Split Deploy: no nginx)
# Web: urlshortener.devisuru.ggff.net
# API: api.urlshortener.devisuru.ggff.net
# ======================================

APP_ENV=production

# Public base URLs
PUBLIC_WEB_BASE_URL=https://urlshortener.devisuru.ggff.net
PUBLIC_API_BASE_URL=https://api.urlshortener.devisuru.ggff.net
NEXT_PUBLIC_API_BASE=https://api.urlshortener.devisuru.ggff.net

# PostgreSQL
POSTGRES_DB=paidlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_HOST=REPLACE_DB_HOST
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/paidlink

# Redis
REDIS_URL=redis://default:REPLACE_REDIS_PASSWORD@REPLACE_REDIS_HOST:6379/0

# Security
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=30
REDIRECT_TOKEN_EXPIRE_MINUTES=10

# Flow / Anti-fraud
FIRST_STEP_MIN_SECONDS=8
NEXT_STEP_MIN_SECONDS=3
STEP_RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300

# Optional
TIERS_FILE_PATH=/packages/shared/tiers.json
